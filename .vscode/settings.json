{
  // latexmk sin flags propios: manda el .latexmkrc de cada documento (xelatex + biber, salida en build/)
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (.latexmkrc)", "tools": ["latexmk-rc"] }
  ],
  "latex-workshop.latex.tools": [
    { "name": "latexmk-rc", "command": "latexmk", "args": ["%DOC%"], "env": {} }
  ],
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.build.forceRecipeUsage": true
}
